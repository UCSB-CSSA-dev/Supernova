# Public Apps Script web app URL ending in /exec. Safe to expose; it is not a secret.
NEXT_PUBLIC_APPS_SCRIPT_URL=

# OAuth 2.0 web client ID from Google Cloud (ends in .apps.googleusercontent.com). Public, not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Set only for the GitHub Pages build. Leave empty for local `npm run dev`.
# NEXT_PUBLIC_BASE_PATH=/supernova
